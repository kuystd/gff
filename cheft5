--========================
-- Save / Load Config
--========================

local function saveConfig()
    if not writefile then
        return notify("ผิดพลาด", "ไม่รองรับการเซฟไฟล์ (writefile)", 3)
    end

    local pointsList = {}
    for _, p in ipairs(points) do
        table.insert(pointsList, { x = p.position.X, y = p.position.Y, z = p.position.Z, waitTime = p.waitTime, slot = p.slot })
    end

    local saveData = {
        walkSpeed = walkSpeed,
        promptDelay = promptDelay,
        customHoldTime = customHoldTime,
        overrideHoldDuration = overrideHoldDuration,
        autoDepositEnabled = autoDepositEnabled,
        depositThreshold = depositThreshold,
        pointsList = pointsList
    }

    writefile(fileName, HttpService:JSONEncode(saveData))
    notify("บันทึกสำเร็จ", string.format("บันทึกจุดพิกัด %d จุดลงไฟล์เรียบร้อย!", #points), 3)
end

local function loadConfig()
    if not readfile or not isfile or not isfile(fileName) then
        return notify("แจ้งเตือน", "ไม่พบไฟล์บันทึกตั้งค่าที่เคยเซฟไว้", 3)
    end

    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(fileName))
    end)

    if success and result then
        walkSpeed = result.walkSpeed or walkSpeed
        promptDelay = result.promptDelay or promptDelay
        customHoldTime = result.customHoldTime or customHoldTime
        overrideHoldDuration = result.overrideHoldDuration or false
        depositThreshold = result.depositThreshold or depositThreshold
        if result.autoDepositEnabled ~= nil then autoDepositEnabled = result.autoDepositEnabled end

        points = {}
        if result.pointsList then
            for _, p in ipairs(result.pointsList) do
                table.insert(points, { position = Vector3.new(p.x, p.y, p.z), waitTime = p.waitTime or 3, slot = p.slot or 0 })
            end
        end

        updateStatus("โหลดข้อมูลตั้งค่าสำเร็จ")
        notify("โหลดสำเร็จ", string.format("โหลดจุดพิกัดเรียบร้อย (%d จุด)", #points), 3)
    end
end

--========================
-- Main Execution Loop
--========================

local function startWorking()
    if #points == 0 then return end

    task.spawn(function()
        local loopCount = 1

        while running do
            for i = currentPointIndex, #points do
                if not running then break end
                currentPointIndex = i

                local loopInfo = loopEnabled and string.format(" (รอบที่ %d)", loopCount) or ""
                updateStatus("กำลังเดินไปจุดที่ " .. i .. loopInfo)

                if walkTo(points[i].position) and running then
                    updateStatus("ถึงจุดที่ " .. i .. " - กำลังกดปุ่ม E...")

                    local prompt = findAndTriggerPrompt(points[i].position)
                    if prompt then
                        notify("พบปุ่มกด", "กดปุ่ม: " .. prompt.Parent.Name, 1.5)
                    end

                    task.wait(0.2)

                    if points[i].slot and points[i].slot > 0 then
                        equipSlot(points[i].slot)
                        updateStatus("ถือไอเทมช่องที่ " .. points[i].slot)
                    end

                    checkAndDeposit()
                    task.wait(points[i].waitTime)
                elseif running then
                    updateStatus("เดินไปจุดที่ " .. i .. " ไม่สำเร็จ (ข้ามจุด)")
                    task.wait(1)
                end
            end

            if not loopEnabled or not running then break end
            currentPointIndex = 1
            loopCount = loopCount + 1
            task.wait(0.5)
        end

        if not running then updateStatus("หยุดการทำงานแล้ว") end
    end)
end

-- ตัวละครเกิดใหม่
player.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        applyWalkSpeed(hum)
        if running and #points > 0 then
            task.wait(2)
            startWorking()
        end
        hum.Died:Connect(function()
            if running then updateStatus("ตัวละครตาย - รอเกิดใหม่เพื่อทำงานต่อ...") end
        end)
    end
end)

